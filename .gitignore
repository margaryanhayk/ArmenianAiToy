# .NET
backend/**/bin/
backend/**/obj/
tools/**/bin/
tools/**/obj/

# BenchmarkAll per-run reports (written under source, not bin/)
tools/BenchmarkAll/results/
backend/**/*.user
backend/**/*.suo
backend/.vs/

# Python caches
**/__pycache__/

# Local Claude agent state
backend/.claude/agent-memory/
/.claude/agent-memory/
esp32/AregVoiceMvp/.claude/

# Local-only Claude settings (may contain secrets/API keys — never commit)
.claude/settings.local.json

# Claude scratch / logs / backups (not source)
.claude/monitor.log
*.bak-*
*.db.bak*

# Local project status export
ArmenianAiToy_Project_Status.pdf

# User secrets (API keys)
**/secrets.json

# SQLite databases
*.db
*.db-shm
*.db-wal

# Startup migration advisory lock (#025)
db-migration.lock

# IDE
.idea/
.vscode/
*.swp
*.swo

# C1 voice path runtime artifacts (LocalDiskAudioBlobStore writes child
# WAV + assistant MP3 here; not source).
backend/src/ArmenianAiToy.Api/audio-blobs/

# Pre-rendered whole-story MP3 cache (StoryAudioController renders here on
# first request and re-uses it; regenerated on demand, not source).
backend/src/ArmenianAiToy.Api/story-audio-cache/

# F1 — StoryModelBakeoff per-run side-by-side reports (slice 2 only;
# scaffold ships empty). Local research output, not source.
tools/StoryModelBakeoff/results/

# Generated offline SD content pack (audio artifacts — see tools/ContentPackBuilder)
sd-content-pack/

# Firmware secrets — copy config.h.example -> config.h and fill in locally.
esp32/AregVoiceMvp/config.h

# Voice-audition intermediates — the finished renders are kept, the
# per-chunk pieces are regenerable and just bulk.
tools/voice-audition/_chunks/

# Scratch output from tools/ElevenLabsRender — the installed copies under
# story-audio/ are the shipped ones; these are the pre-levelling renders.
tools/.render-out/

# Scratch output from tools/story-voices/render_story.py (per
# docs/variant-endings-serial-render-runbook.md) — same posture: the shipped
# copies under story-audio/ are what ships, these are pre-levelling.
render-out/

# Firmware images never go into git (chip security review, 2026-10-08): the
# repository has been PUBLIC, so every committed image -- and the manifest
# HMAC key compiled into it -- must be treated as published. Serve release
# images from private storage (a Railway volume + FirmwareUpdate__ImagePath).
# The one image still tracked here is untracked by the OWNER once the served
# copy lives on the volume:
#   git rm --cached backend/src/ArmenianAiToy.Api/firmware/areg-current.bin
# (docs/firmware-security.md s11). Tracked files are unaffected by this rule.
backend/src/ArmenianAiToy.Api/firmware/*.bin

# Secure Boot PRIVATE keys never enter git; only the public halves
# (*.pub.pem) and the digests file are committed (esp32/security/README.md;
# chip security review round 3). A key made inside the repo by mistake is then
# at least never picked up by `git add -A`.
*.pem
!*.pub.pem

# Factory station output: printed labels (claim code + PoP QR), PoP stickers,
# factory-record.json / INCOMPLETE.json and -- DEV profile -- nvs.bin with the
# toy's PLAINTEXT device key. The tools now default to ~/areg-factory-out
# (outside the repo); this catches an explicit --out-dir/--out-root here.
tools/factory/out/
