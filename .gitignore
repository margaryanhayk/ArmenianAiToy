# .NET
backend/**/bin/
backend/**/obj/
tools/**/bin/
tools/**/obj/

# BenchmarkAll per-run reports (written under source, not bin/)
tools/BenchmarkAll/results/
backend/**/*.user
backend/**/*.suo
backend/.vs/

# Python caches
**/__pycache__/

# Local Claude agent state
backend/.claude/agent-memory/
/.claude/agent-memory/
esp32/AregVoiceMvp/.claude/

# Local-only Claude settings (may contain secrets/API keys — never commit)
.claude/settings.local.json

# Claude scratch / logs / backups (not source)
.claude/monitor.log
*.bak-*
*.db.bak*

# Local project status export
ArmenianAiToy_Project_Status.pdf

# User secrets (API keys)
**/secrets.json

# SQLite databases
*.db
*.db-shm
*.db-wal

# Startup migration advisory lock (#025)
db-migration.lock

# IDE
.idea/
.vscode/
*.swp
*.swo

# C1 voice path runtime artifacts (LocalDiskAudioBlobStore writes child
# WAV + assistant MP3 here; not source).
backend/src/ArmenianAiToy.Api/audio-blobs/

# Pre-rendered whole-story MP3 cache (StoryAudioController renders here on
# first request and re-uses it; regenerated on demand, not source).
backend/src/ArmenianAiToy.Api/story-audio-cache/

# F1 — StoryModelBakeoff per-run side-by-side reports (slice 2 only;
# scaffold ships empty). Local research output, not source.
tools/StoryModelBakeoff/results/

# Generated offline SD content pack (audio artifacts — see tools/ContentPackBuilder)
sd-content-pack/

# Firmware secrets — copy config.h.example -> config.h and fill in locally.
esp32/AregVoiceMvp/config.h

# Voice-audition intermediates — the finished renders are kept, the
# per-chunk pieces are regenerable and just bulk.
tools/voice-audition/_chunks/

# Scratch output from tools/ElevenLabsRender � the installed copies under
# story-audio/ are the shipped ones; these are the pre-levelling renders.
tools/.render-out/

# Generated listen-test page (7 MB of embedded audio; rebuild with
# tools/story-audio/build_clip_listen_page.py)
tools/story-audio/clip-listen-test.html
