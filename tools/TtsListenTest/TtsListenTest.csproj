<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ArmenianAiToy.Tools.TtsListenTest</RootNamespace>
  </PropertyGroup>

  <!--
    Application: curated story library (the texts under test, read
    directly so byte-identity with runtime is automatic).
    Infrastructure: OpenAITtsSynthesisService — the PRODUCTION TTS
    adapter, reused as-is for voice/model/format parity by
    construction. The OpenAI SDK flows transitively; no new NuGet.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\backend\src\ArmenianAiToy.Application\ArmenianAiToy.Application.csproj" />
    <ProjectReference Include="..\..\backend\src\ArmenianAiToy.Infrastructure\ArmenianAiToy.Infrastructure.csproj" />
  </ItemGroup>

</Project>
