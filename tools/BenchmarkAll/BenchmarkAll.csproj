<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Shared bench setup (claim, validity, latency, CLI) — linked as source,
       no NuGet and no ProjectReference (C186). -->
  <ItemGroup>
    <Compile Include="..\BenchCommon\*.cs" Link="BenchCommon\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
