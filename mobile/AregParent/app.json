{
  "expo": {
    "name": "Areg",
    "slug": "areg-parent",
    "scheme": "areg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.areg.parent",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.areg.parent",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1D6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "@orbital-systems/react-native-esp-idf-provisioning",
        {
          "bluetoothAlwaysPermission": "Areg uses Bluetooth to set up your toy's Wi-Fi.",
          "locationWhenInUsePermission": "Location is needed to find your toy over Bluetooth.",
          "localNetworkPermission": "Local network access lets Areg talk to your toy during setup."
        }
      ]
    ],
    "owner": "test111111s-team",
    "extra": {
      "eas": {
        "projectId": "71244ba2-ff1e-40f1-92d4-441e6afe6d7a"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71244ba2-ff1e-40f1-92d4-441e6afe6d7a"
    }
  }
}
