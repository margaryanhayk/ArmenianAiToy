{
  "permissions": {
    "allow": [
      "Bash(curl -fsSL -o * https://downloads.arduino.cc/arduino-cli/*)",
      "Bash(tar xzf * arduino-cli)",
      "Bash(~/bin/arduino-cli *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-commit.py\""
          }
        ]
      }
    ]
  }
}
