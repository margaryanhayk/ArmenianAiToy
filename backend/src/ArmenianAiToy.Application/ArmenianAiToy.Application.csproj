<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ArmenianAiToy.Domain\ArmenianAiToy.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.16.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArmenianAiToy.Application.Tests" />
  </ItemGroup>

  <!--
    Approved curated story content. Presence in Stories/Content/ means
    APPROVED — the embedded loader hard-fails on any file whose
    review.status is not "approved". Drafts live outside backend/src
    (backend/content/story-drafts/) and are never embedded.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Stories\Content\*.story.json" />
  </ItemGroup>

</Project>
