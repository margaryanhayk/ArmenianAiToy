    "//": "#007/#008 app-side HTTPS. OFF by default (opt-in deploy switch).",
    "//RequireHttps": "true once TLS is terminated (Kestrel, or a proxy that forwards X-Forwarded-Proto with ForwardedHeaders enabled). Redirects HTTP->HTTPS and emits HSTS.",
    "RequireHttps": false,
    "HstsMaxAgeDays": 365
  },
  "AI": {
    "//": "Per-capability provider switch. Bounded value space: chat = openai|gemini, tts = openai|elevenlabs, others = openai. Unknown value = refuse to boot. PROD NOTE: production runs chat=gemini via Railway env vars (AI__ChatProvider) — the Railway dashboard is the source of truth for live provider selection. Model names WITHIN a provider are that provider's own keys (OpenAI:ChatModel etc.). No provider/model flip reaches children without a benchmark run + the owner listen test.",
    "ChatProvider": "openai",
    "TranscriptionProvider": "openai",
    "//TtsProvider": "openai | elevenlabs. elevenlabs = the eleven_v3 storyteller clone speaks LIVE (owner listen-test winner 2026-08-05); requires ElevenLabs:ApiKey + :VoiceId (or the ELEVENLABS_* env names). Buffered latency 3-5s/line until the firmware streaming slice lands; first-byte is ~1s.",
    "TtsProvider": "openai",
    "//ChatCost": "Optional explicit chat token rates (USD per 1M tokens) for the daily cost cap. Empty = provider default: openai 2.50/10.00 (gpt-4o), gemini 0.50/3.00 (flash-class list ~0.30/2.50, set a touch high so the cap fires early). Invariant-culture decimals.",
    "ChatCostPerMTokensIn": "",
    "ChatCostPerMTokensOut": "",
    "ModerationProvider": "openai"
  },
  "ElevenLabs": {
    "ApiKey": "",
    "VoiceId": "",
    "ModelId": "eleven_v3"
  },
  "Gemini": {
    "//": "Chat brain when AI:ChatProvider=gemini (owner bake-off decision 2026-08-06). Default model moved to stable gemini-3.6-flash 2026-08-06: the -preview endpoint 503d on ~17% of requests. 3.6 REJECTS thinkingConfig — set Gemini:ThinkingBudget ONLY for older preview models (0 = thinking off). Key also accepted from the GEMINI_API_KEY env name.",
    "ApiKey": "",
    "Model": "gemini-3.6-flash",
    "//SafetyThreshold": "Gemini's OWN per-request safety filter (owner approval 2026-08-06). Empty = BLOCK_LOW_AND_ABOVE (strictest). Allowed: BLOCK_LOW_AND_ABOVE | BLOCK_MEDIUM_AND_ABOVE | BLOCK_ONLY_HIGH. BLOCK_NONE is refused; unknown value refuses boot. A Gemini-side block returns the calm SafetyFallbackResponse line, never a 502.",
    "SafetyThreshold": ""
  },
  "OpenAI": {
    "ApiKey": "",
    "ChatModel": "gpt-4o",
    "//TtsVoice": "The voice Areg SPEAKS in (answers, reactions, canned lines) — NOT the story narration, which is pre-rendered ElevenLabs audio shipped in story-audio/. alloy | echo | fable | onyx | nova | shimmer. Unset or unknown -> nova (what shipped before this key existed).",
