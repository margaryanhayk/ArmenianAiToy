<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>f2f0775b-5ced-46be-8abf-e8a26ebb77e0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="OpenAI" Version="2.9.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.3-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArmenianAiToy.Application\ArmenianAiToy.Application.csproj" />
    <ProjectReference Include="..\ArmenianAiToy.Infrastructure\ArmenianAiToy.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Format-matched (24 kHz mono MP3) silence unit, generated once with
    ffmpeg. StoryQaController repeats it to insert a tunable pause between
    a spoken answer and the return-to-story bridge. Embedded so it ships
    with the API regardless of the working directory at runtime.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\silence-24k-mono.mp3" />
  </ItemGroup>

  <!--
    Matches the InternalsVisibleTo declarations already present on
    Application and Infrastructure. Lets the test project reference
    internal constants on Api controllers (e.g. ChatController.CostCapResponse
    pinned by ChatControllerCostCapTests).
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ArmenianAiToy.Application.Tests" />
  </ItemGroup>

  <!--
    Pre-rendered story narration shipped INSIDE the image. These are the
    files GET /api/devices/content-file streams to the toy, which then
    caches them on its SD card - that is the only way the toy's narration
    voice can be anything other than the backend's runtime TTS voice.
    Deliberately NOT wwwroot: the endpoint is device-authed, so the audio
    is not openly downloadable.
    Resolved at runtime via ContentSync:AudioRoot ("story-audio"), which
    is relative to the app base directory and therefore identical on the
    Windows bench and in the Linux container.
  -->
  <ItemGroup>
    <Content Include="story-audio\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <!--
      Game clips live in per-game SUBFOLDERS (story-audio/games/<key>/<clip>.mp3)
      because four games each define a clip called "intro". The top-level glob
      above does not recurse, so without this line the manifest advertises 92
      clips the content-file endpoint then 404s — found exactly that way on the
      bench, 2026-08-07.
    -->
    <Content Include="story-audio\games\**\*.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    OTA firmware images shipped INSIDE the backend image, for the same
    reason as story-audio above: GET /api/devices/firmware-image is
    device-authed and streams from disk, so the .bin must exist next to
    the app at runtime and must NOT be a public wwwroot file.
    Unlike story-audio (resolved through ContentSync:AudioRoot, which is
    app-relative), FirmwareUpdate:ImagePath is required to be ABSOLUTE by
    DeviceController.GetFirmwareImage — so the deployment sets it by env
    var (Railway: /app/firmware/areg-<ver>.bin; local bench: the full
    Windows path). Copying it here is what makes that path exist.
  -->
  <ItemGroup>
    <Content Include="firmware\*.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
