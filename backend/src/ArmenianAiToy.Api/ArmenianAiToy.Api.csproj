<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>f2f0775b-5ced-46be-8abf-e8a26ebb77e0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="OpenAI" Version="2.9.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.3-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArmenianAiToy.Application\ArmenianAiToy.Application.csproj" />
    <ProjectReference Include="..\ArmenianAiToy.Infrastructure\ArmenianAiToy.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Format-matched (24 kHz mono MP3) silence unit, generated once with
    ffmpeg. StoryQaController repeats it to insert a tunable pause between
    a spoken answer and the return-to-story bridge. Embedded so it ships
    with the API regardless of the working directory at runtime.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\silence-24k-mono.mp3" />
  </ItemGroup>

  <!--
    Matches the InternalsVisibleTo declarations already present on
    Application and Infrastructure. Lets the test project reference
    internal constants on Api controllers (e.g. ChatController.CostCapResponse
    pinned by ChatControllerCostCapTests).
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ArmenianAiToy.Application.Tests" />
  </ItemGroup>

</Project>
