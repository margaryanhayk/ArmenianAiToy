# Rendered failure clip (regenerated by tools/render_canned_clip.sh).
# canned_clip.h itself IS committed (as a 1-byte stub); the raw .mp3
# byproduct of the render step stays out of the repo.
canned_clip.mp3

# Arduino / PlatformIO build artifacts.
# build/ is the default output dir; build_* are the per-flag bench build
# dirs (build_sddiag, build_contentsync, build_sdplayback, ...). Ignore all
# of them so local Arduino build folders never get staged.
build/
build_*/
*.elf
*.bin
*.map

# Local environment secrets (in case anyone saves creds here).
.env
